# Find your AI MATCH. Never commit real values.

# Already used by the recommendation route. Server only.
OPENAI_API_KEY=

# Optional override for AI Match (default: gpt-4o-mini)
OPENAI_MATCH_MODEL=

# HMAC secret for the light arithmetic captcha. At least 16 random characters.
# Required in production. In development a local stand-in is used when this is empty.
MATCH_CAPTCHA_SECRET=

# Shared per-IP counters. The route reads one of these pairs.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN win when both pairs are set.
# KV_REST_API_READ_ONLY_TOKEN, KV_URL and REDIS_URL are not read.
# Production: missing pair → 503. Redis timeout/error → per-instance memory fallback.
# Optional REST timeout for AI Match rate limit + captcha nonce (default 2500 ms).
MATCH_REDIS_TIMEOUT_MS=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# YouTube channel strip under the header (homepage + all pages). Off by default.
# Set ENABLED=true and a non-empty URL to show the banner.
NEXT_PUBLIC_YOUTUBE_CHANNEL_BANNER_ENABLED=
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=
