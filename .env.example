# Find your AI MATCH. Never commit real values.

# Already used by the recommendation route. Server only.
OPENAI_API_KEY=

# HMAC secret for the light arithmetic captcha. At least 16 random characters.
# Required in production. In development a local stand-in is used when this is empty.
MATCH_CAPTCHA_SECRET=

# Shared per-IP counters. The route reads one of these pairs.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN win when both pairs are set.
# KV_REST_API_READ_ONLY_TOKEN, KV_URL and REDIS_URL are not read.
# In production and preview, a missing or failing store makes search return 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
