# Find your AI MATCH. Never commit real values.

# Already used by the recommendation route. Server only.
OPENAI_API_KEY=

# HMAC secret for the light arithmetic captcha. At least 16 random characters.
# Required in production. In development a local stand-in is used when this is empty.
MATCH_CAPTCHA_SECRET=

# Shared per-IP counters on Vercel. Create an Upstash Redis database from the
# Vercel Marketplace and paste its REST credentials. KV_REST_API_URL and
# KV_REST_API_TOKEN are accepted aliases. Without these, each server instance
# keeps its own counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Defaults: 10 searches per 1800 seconds.
# MATCH_RATE_LIMIT_MAX=10
# MATCH_RATE_LIMIT_WINDOW_SEC=1800
